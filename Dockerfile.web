FROM python:3.12-slim-trixie
WORKDIR /app

# Only the `web` extras — no Telethon, ffmpeg or basemap in this image.
COPY README.md pyproject.toml ./
RUN pip install --no-cache-dir $(python -c 'import tomllib;print(" ".join(tomllib.load(open("pyproject.toml","rb"))["project"]["optional-dependencies"]["web"]))')

COPY src/ ./src/
RUN pip install --no-cache-dir --no-deps .

RUN useradd --create-home --uid 10001 kodzuweb
USER kodzuweb
EXPOSE 8080

CMD ["python", "-u", "-m", "kodzu_thon.web"]
