FROM python:3.12-slim-trixie
WORKDIR /app
# The package runs straight from the source tree: no `pip install .`, which needed the
# network and a wheel build on every code change.
ENV PYTHONPATH=/app/src \
    PIP_DISABLE_PIP_VERSION_CHECK=1

RUN useradd --create-home --uid 10001 kodzuweb

# Only the `web` extras — no Telethon, ffmpeg or basemap in this image. When pyproject.toml
# changes, the cache mount keeps already-downloaded wheels on the build host.
COPY pyproject.toml ./
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install $(python -c 'import tomllib;print(" ".join(tomllib.load(open("pyproject.toml","rb"))["project"]["optional-dependencies"]["web"]))')

# Last: the only layer rebuilt by a code change.
COPY src/ ./src/

USER kodzuweb
EXPOSE 8080

CMD ["python", "-u", "-m", "kodzu_thon.web"]
